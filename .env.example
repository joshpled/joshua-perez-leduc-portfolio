# Copy to .env.local. Enter private values locally or in Vercel, never in chat.
# Use a sending-only Resend key restricted to the verified forms subdomain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contact@forms.allpurposeapps.com
# Only the site key is passed to the browser; both are read at request time.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra EXACT origins for local development or a trusted PR preview, comma-separated.
# Production domains are already allowed. Add preview hostname to Turnstile too.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000
