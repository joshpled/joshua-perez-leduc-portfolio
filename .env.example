# Copy to .env.local. Enter private values locally or in Vercel, never in chat.
SUPABASE_URL=https://vujrrskdxtskmkldvnkj.supabase.co
# Use a Supabase sb_secret_ key, only on the server. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Only the site key is passed to the browser; both are read at request time.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra EXACT origins for local development or a trusted PR preview, comma-separated.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000

# Google app password for info@allpurposeapps.com; server-only, never your login password.
# Missing/invalid credentials disable email alerts, but inquiries are still saved.
GOOGLE_APP_PASSWORD=
